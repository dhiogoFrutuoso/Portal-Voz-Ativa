# Copie para .env e preencha. Em produção, defina estas variáveis no painel do Render/Vercel.

# Banco de dados (a aplicação escolhe pela NODE_ENV)
MONGO_URI_PROD=
MONGO_URI_DEV=

# Cloudinary — CLOUD_NAME e UPLOAD_PRESET são públicos (aparecem no HTML);
# API_KEY e API_SECRET são secretos e usados só no servidor.
CLOUDINARY_CLOUD_NAME=dnh7vok3r
CLOUDINARY_UPLOAD_PRESET=Portal-Voz-Ativa
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# reCAPTCHA — SITE_KEY é público, SECRET fica só no servidor.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Assinatura dos cookies de sessão (obrigatório: use um valor longo e aleatório)
SESSION_SECRET=

# --- Envio de e-mail: avisos de resposta e mudança de estágio ---
# Sem nenhuma das opções abaixo o portal roda normal, só não manda e-mail.
#
# OPÇÃO A (sem domínio próprio): SMTP do Gmail.
# Exige 2FA ativado na conta e uma "senha de app" de 16 dígitos gerada em
# myaccount.google.com/apppasswords. Entrega para qualquer destinatário,
# limite de 500 por dia. Se estiver preenchido, tem preferência.
SMTP_USUARIO=
SMTP_SENHA=
# Só mude se não for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
#
# OPÇÃO B (com domínio próprio): Resend.
# Enquanto o domínio não estiver verificado em resend.com/domains, a conta só
# entrega no e-mail do dono — não serve para avisar cidadão.
RESEND_API_KEY=

# Remetente exibido. Vazio com SMTP = usa o próprio SMTP_USUARIO.
EMAIL_REMETENTE=

# Usada para montar os links dos e-mails; sem barra no final.
URL_PUBLICA=https://portal-voz-ativa.onrender.com

PORT=8080
NODE_ENV=development
