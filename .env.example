# Copie para .env e preencha. Em produção, defina estas variáveis no painel do Render/Vercel.

# Banco de dados (a aplicação escolhe pela NODE_ENV)
MONGO_URI_PROD=
MONGO_URI_DEV=

# Cloudinary — CLOUD_NAME e UPLOAD_PRESET são públicos (aparecem no HTML);
# API_KEY e API_SECRET são secretos e usados só no servidor.
CLOUDINARY_CLOUD_NAME=dnh7vok3r
CLOUDINARY_UPLOAD_PRESET=Portal-Voz-Ativa
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# reCAPTCHA — SITE_KEY é público, SECRET fica só no servidor.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Assinatura dos cookies de sessão (obrigatório: use um valor longo e aleatório)
SESSION_SECRET=

# Envio de e-mail (Resend) — avisos de resposta e mudança de estágio.
# Sem RESEND_API_KEY o portal roda normalmente, só não manda e-mail.
RESEND_API_KEY=
# Enquanto não houver domínio verificado no Resend, use o remetente de teste
# abaixo — ele só entrega para o e-mail dono da conta Resend.
EMAIL_REMETENTE=Portal Voz Ativa <onboarding@resend.dev>
# Usada para montar os links dos e-mails; sem barra no final.
URL_PUBLICA=https://portal-voz-ativa.onrender.com

PORT=8080
NODE_ENV=development
