<style>
    .estagio-chip {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
    }

    .protocolo-linha {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .protocolo-linha:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
    }

    .faixa-status {
        width: 6px;
        border-radius: 0.9rem 0 0 0.9rem;
    }
</style>

<header class="py-5 text-white shadow-lg" style="background: linear-gradient(145deg, #13315c 0%, #0056b3 100%); border-bottom: 5px solid #ffc107;">
    <div class="container px-4">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
            <i class="bi bi-folder-check me-1"></i> ACOMPANHAMENTO
        </span>
        <h1 class="display-5 fw-bolder mb-2">Meus Protocolos</h1>
        <p class="lead mb-0 opacity-75 fw-light">
            Acompanhe o andamento das melhorias e denúncias que você registrou.
        </p>
    </div>
</header>

<section class="py-5 bg-light">
    <div class="container px-4">

        {{!-- Resumo por estágio --}}
        <div class="row g-3 mb-5">
            {{#each resumo}}
                <div class="col-6 col-lg">
                    <div class="estagio-chip p-3 h-100 shadow-sm">
                        <div class="text-{{this.cor}} fs-4 mb-1"><i class="bi {{this.icone}}"></i></div>
                        <div class="h4 fw-bold mb-0">{{this.total}}</div>
                        <div class="small text-muted">{{this.rotulo}}</div>
                    </div>
                </div>
            {{/each}}
        </div>

        {{#if protocolos.length}}
            <div class="d-flex flex-column gap-3">
                {{#each protocolos}}
                    <div class="protocolo-linha shadow-sm overflow-hidden">
                        <div class="d-flex">
                            <div class="faixa-status bg-{{this.estagio.cor}}"></div>

                            <div class="flex-grow-1 p-4">
                                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                    <span class="badge bg-{{this.eixo.cor}} rounded-pill px-3">
                                        <i class="bi {{this.eixo.icone}} me-1"></i>{{this.eixo.rotuloCurto}}
                                    </span>
                                    <span class="badge bg-{{this.estagio.cor}} rounded-pill px-3">
                                        {{this.estagio.rotulo}}
                                    </span>
                                    <span class="small text-muted font-monospace">{{this.numero}}</span>
                                    <span class="small text-muted ms-auto">
                                        <i class="bi bi-clock me-1"></i>{{fromNow this.dataCriacao}}
                                    </span>
                                </div>

                                <h5 class="fw-bold mb-1">{{this.titulo}}</h5>
                                <p class="text-muted small mb-3">{{recortar this.descricao 160}}</p>

                                <div class="d-flex align-items-center flex-wrap gap-3 small text-muted">
                                    <span><i class="bi bi-geo-alt me-1"></i>{{recortar this.localizacao 45}}</span>
                                    <span><i class="bi bi-chat-left-text me-1"></i>{{this.historico.length}} resposta(s)</span>
                                    <span><i class="bi bi-calendar-check me-1"></i>Prazo: {{this.prazo.dias}} dias úteis</span>

                                    <a href="/protocolos/{{this.tipo}}/{{this._id}}" class="btn btn-sm btn-primary rounded-3 ms-auto px-3 fw-bold">
                                        Acompanhar <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-folder2-open"></i></div>
                <h5 class="fw-bold">Você ainda não abriu nenhum protocolo</h5>
                <p class="text-muted mb-4">
                    Registre uma melhoria ou uma denúncia e acompanhe a resposta da gestão por aqui.
                </p>
                <a href="/categories/gestao_de_melhorias/abrir-chamado" class="btn btn-primary rounded-3 px-4 fw-bold me-2">
                    Registrar melhoria
                </a>
                <a href="/categories/denuncias_sigilosas/abrir-denuncia" class="btn btn-outline-danger rounded-3 px-4 fw-bold">
                    Registrar denúncia
                </a>
            </div>
        {{/if}}
    </div>
</section>
