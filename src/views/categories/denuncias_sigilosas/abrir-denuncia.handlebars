<section class="py-5 bg-light" style="min-height: 90vh;">
    <div class="container px-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header p-4 border-0 text-center" style="background-color: #dc3545;">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold small mb-2">
                            <i class="bi bi-shield-check me-1"></i>TRIAGEM ADMINISTRATIVA • PILOTO 90 DIAS
                        </span>
                        <h3 class="text-white fw-bold mb-0"><i class="bi bi-shield-lock-fill me-2"></i>Nova Denúncia Sigilosa</h3>
                        <p class="text-white-50 mb-0 small text-uppercase tracking-wider">Sua identidade está protegida por criptografia</p>
                    </div>
                    
                    <div class="card-body p-4 p-md-5 bg-white">

                        {{!-- AVISO DE EMERGÊNCIA (190 e 181) --}}
                        <div class="alert border-0 rounded-4 mb-4 p-3 shadow-sm"
                             style="background: #fff0f1; border: 2px solid #dc3545 !important;">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-telephone-inbound-fill text-danger fs-3 flex-shrink-0"></i>
                                <div class="small">
                                    <strong class="d-block text-danger text-uppercase mb-1">Atenção: Canal Cívico — Emergências Ligue 190 ou 181</strong>
                                    O Portal Voz Ativa é um canal cívico de triagem administrativa e zeladoria. <strong>Ocorrências graves em tempo real, crimes em andamento ou risco imediato à vida devem ser comunicados imediatamente aos telefones oficiais de segurança:</strong>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <a href="tel:190" class="btn btn-sm btn-danger rounded-pill fw-bold px-3">
                                            <i class="bi bi-telephone-fill me-1"></i>190 • Polícia Militar
                                        </a>
                                        <a href="tel:181" class="btn btn-sm btn-dark rounded-pill fw-bold px-3">
                                            <i class="bi bi-shield-lock-fill me-1"></i>181 • Disque-Denúncia
                                        </a>
                                        <a href="tel:193" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3">
                                            <i class="bi bi-fire me-1"></i>193 • Bombeiros
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <form id="mainForm" action="/categories/denuncias_sigilosas/abrir-denuncia" method="POST">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">

                        {{!-- Cláusula de atendimento: prazos por gravidade da ocorrência --}}
                        <div class="alert border-0 rounded-3 mb-4 d-flex gap-3"
                             style="background: #fff5f5; border-left: 4px solid #e63946 !important;">
                            <i class="bi bi-shield-exclamation text-danger fs-5"></i>
                            <div class="small">
                                <strong class="d-block mb-1">Como funciona o atendimento</strong>
                                A denúncia gera um número de protocolo e o prazo de resposta varia com a
                                urgência: <strong>2 dias úteis</strong> para focos de queimada,
                                <strong>3 dias</strong> para maus-tratos a animais e
                                <strong>5 dias úteis</strong> para as demais ocorrências. Todo relato passa por <strong>moderação prévia</strong> e o acompanhamento
                                fica em <a href="/protocolos" class="fw-bold">Meus Protocolos</a>, visível
                                só para você e para a gestão.
                            </div>
                        </div>
                            
                            <div class="row g-3 mb-4">
                                <div class="col-md-7">
                                    <label class="form-label fw-bold text-secondary small text-uppercase">Infração / Ocorrência (Escopo do Piloto)</label>
                                    <select name="tipoOcorrencia" id="tipoOcorrencia" class="form-select custom-input" required onchange="toggleOutroField()">
                                        <option value="" selected disabled>Selecione a infração objetiva...</option>
                                        <option value="Descarte Irregular de Lixo">Descarte Irregular de Lixo / Entulho</option>
                                        <option value="Foco de Queimada">Foco de Queimada / Incêndio Ambiental</option>
                                        <option value="Maus-tratos contra Animais">Maus-tratos ou Abandono de Animais</option>
                                        <option value="Poluição Sonora">Poluição Sonora (Perturbação do Sossego)</option>
                                        <option value="Vandalismo">Vandalismo / Dano ao Patrimônio Público</option>
                                        <option value="Obstrução de Via ou Calçada">Obstrução Irregular de Via ou Calçada</option>
                                        <option value="Outro">Outra Infração Objetiva (Especificar abaixo)</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold text-secondary small text-uppercase">Bairro / Localidade</label>
                                    <select name="bairro" class="form-select custom-input">
                                        <option value="">Identificar pelo endereço</option>
                                        <option value="Centro">Centro</option>
                                        <option value="São Vicente">São Vicente</option>
                                        <option value="Nossa Senhora de Fátima">Nossa Senhora de Fátima</option>
                                        <option value="Esplanada">Esplanada</option>
                                        <option value="COHAB">COHAB</option>
                                        <option value="Bela Vista">Bela Vista</option>
                                        <option value="Distrito de Caio Prado">Distrito de Caio Prado</option>
                                        <option value="Distrito de São Sebastião">Distrito de São Sebastião</option>
                                        <option value="Distrito de Angicos">Distrito de Angicos</option>
                                        <option value="Zona Rural / Sítios">Zona Rural / Sítios</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-4 d-none" id="campoOutro">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Especifique a Ocorrência</label>
                                <input type="text" name="titulo" id="inputOutro" class="form-control custom-input" placeholder="Ex: Construção irregular em área pública">
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Localização exata (Clique no mapa)</label>
                                <div id="map" class="rounded-4 mb-3 shadow-sm border" style="height: 300px; width: 100%; z-index: 1;"></div>
                                
                                <div class="input-group">
                                    <span class="input-group-text border-0 bg-light text-danger"><i class="bi bi-geo-alt-fill"></i></span>
                                    <input type="text" id="addressInput" name="localizacao" class="form-control custom-input border-start-0" placeholder="Marque o local no mapa" required readonly>
                                </div>
                                
                                <input type="hidden" id="latInput" name="latitude">
                                <input type="hidden" id="lngInput" name="longitude">
                            </div>

                            <div class="row mb-4">
                                <div class="col-12 col-md-6 mb-3 mb-md-0">
                                    <label class="form-label fw-bold text-secondary small text-uppercase">Fotos (Máx 3)</label>
                                    <div class="upload-area rounded-4 p-3 text-center border-dashed bg-light" id="drop-zone-img" onclick="document.getElementById('imgInput').click()">
                                        <input type="file" id="imgInput" accept="image/*" class="d-none" multiple>
                                        <i class="bi bi-camera-fill fs-3 text-primary"></i>
                                        <p class="mb-0 small text-muted">Adicionar Fotos</p>
                                    </div>
                                    <div id="preview-grid" class="row g-2 mt-2 d-none"></div>
                                    
                                    <div id="cloudinaryUrlsContainer"></div>
                                <div class="mt-3">
                                    <label for="videoInput" class="form-label fw-bold">Vídeo (opcional)</label>
                                    <input type="file" id="videoInput" class="form-control" accept="video/mp4,video/webm,video/quicktime" aria-describedby="videoHelp">
                                    <p id="videoHelp" class="small text-muted mt-2">Até 60 segundos. O vídeo será comprimido antes do envio; mantenha esta aba aberta durante o processamento.</p>
                                </div>
                                </div>

                            </div>

                            <div class="mb-5">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Relato Objetivo dos Fatos</label>
                                <textarea name="descricao" class="form-control custom-input" rows="4" placeholder="Descreva os fatos com civilidade e objetividade, sem xingamentos ou ataques pessoais..." required></textarea>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-shield-check me-1"></i>Termos de baixo calão e ofensas pessoais são bloqueados automaticamente pelo filtro de civilidade.</small>
                            </div>

                            <div class="d-grid gap-3">
{{> _declaracao}}

                                <button type="submit" id="submitBtn" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm py-3 transition-base">
                                    <i class="bi bi-shield-check me-2"></i>ENVIAR DENÚNCIA SIGILOSA
                                </button>
                                <a href="/categories/denuncias_sigilosas/hub" class="btn btn-link text-decoration-none text-muted fw-bold">
                                    CANCELAR E VOLTAR
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function toggleOutroField() {
        const select = document.getElementById('tipoOcorrencia');
        const campoOutro = document.getElementById('campoOutro');
        const inputOutro = document.getElementById('inputOutro');
        if (select.value === 'Outro') {
            campoOutro.classList.remove('d-none');
            inputOutro.setAttribute('required', 'required');
        } else {
            campoOutro.classList.add('d-none');
            inputOutro.removeAttribute('required');
        }
    }

    $(document).ready(function() {
        let selectedImages = [];

        const map = L.map('map').setView([-6.5372, -39.4958], 15);
        const camadaTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap © CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);
        camadaTiles.once('tileerror', () => {
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);
        });

        let marker = L.marker([-6.5372, -39.4958], {draggable: true}).addTo(map);

        function updateLocation(lat, lng) {
            $('#latInput').val(lat.toFixed(6));
            $('#lngInput').val(lng.toFixed(6));
            fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                .then(res => res.json())
                .then(data => {
                    if(data.display_name) $('#addressInput').val(data.display_name);
                });
        }

        map.on('click', e => { marker.setLatLng(e.latlng); updateLocation(e.latlng.lat, e.latlng.lng); });
        marker.on('dragend', () => { const p = marker.getLatLng(); updateLocation(p.lat, p.lng); });

        $('#imgInput').on('change', function(e) {
            const files = Array.from(e.target.files);
            files.forEach(f => { if(selectedImages.length < 3) selectedImages.push(f); });
            renderImgPreview();
        });

        window.removeImg = (index) => { selectedImages.splice(index, 1); renderImgPreview(); };

        function renderImgPreview() {
            const $grid = $('#preview-grid');
            $grid.empty().toggleClass('d-none', selectedImages.length === 0);
            selectedImages.forEach((file, i) => {
                const reader = new FileReader();
                reader.onload = e => {
                    $grid.append(`
                        <div class="col-4 position-relative">
                            <img src="${e.target.result}" class="rounded-3 border w-100" style="height:60px; object-fit:cover;">
                            <button type="button" onclick="removeImg(${i})" class="btn btn-danger btn-sm p-0 rounded-circle position-absolute top-0 end-0" style="width:18px;height:18px;font-size:10px;">×</button>
                        </div>
                    `);
                };
                reader.readAsDataURL(file);
            });
        }

        $('#mainForm').on('submit', async function(e) {
            e.preventDefault();
            
            if(!$('#addressInput').val()) {
                window.portalMensagem("Por favor, selecione o local da ocorrência no mapa.");
                return;
            }

            const btn = $('#submitBtn');
            const $container = $('#cloudinaryUrlsContainer');
            const videoFile = document.getElementById('videoInput')?.files?.[0] || null;

            btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Enviando mídias...').prop('disabled', true);
            $container.empty();

            try {
                for (let img of selectedImages) {
                    const resImg = await window.portalEnviarArquivo(img);
                    $container.append(`<input type="hidden" name="imagens_urls[]" value="${resImg.secure_url}">`);
                }

                if (videoFile) {
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Processando vídeo...');
                    const resVid = await window.portalEnviarArquivo(videoFile, {
                        onStatus: (texto) => btn.html(`<span class="spinner-border spinner-border-sm me-2"></span> ${texto}`)
                    });
                    $container.append(`<input type="hidden" name="video_url" value="${resVid.secure_url}">`);
                }

                btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Finalizando...');
                this.submit();

            } catch (err) {
                console.error(err);
                window.portalMensagem(err.message || "Erro no envio dos arquivos. Verifique sua conexão e tente novamente.");
                btn.html('<i class="bi bi-shield-check me-2"></i>ENVIAR DENÚNCIA SIGILOSA').prop('disabled', false);
            }
        });
    });
</script>

<style>
    .custom-input { background-color: #f8f9fa !important; border: 1px solid #dee2e6 !important; border-radius: 12px !important; padding: 12px; }
    .border-dashed { border: 2px dashed #dee2e6; cursor: pointer; transition: 0.3s; }
    .border-dashed:hover { border-color: #dc3545; background-color: #fff5f5 !important; }
    .transition-base { transition: all 0.3s ease; }
</style>
