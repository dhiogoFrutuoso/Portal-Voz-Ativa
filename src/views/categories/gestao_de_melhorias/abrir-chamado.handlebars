<section class="py-5 bg-light" style="min-height: 90vh;">
    <div class="container px-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header p-4 border-0 text-center" style="background-color: #13315c;">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold small mb-2">
                            <i class="bi bi-Lightning-charge-fill me-1"></i>ESCOPO DO PILOTO • 90 DIAS
                        </span>
                        <h3 class="text-white fw-bold mb-0">Novo Chamado de Zeladoria Urbana</h3>
                        <p class="text-white-50 mb-0 small text-uppercase tracking-wider">Cariús mais forte com a sua participação</p>
                    </div>
                    
                    <div class="card-body p-4 p-md-5 bg-white">
                        <form id="mainForm" action="/categories/gestao_de_melhorias/abrir-chamado" method="POST">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">

                        {{!-- Cláusula de atendimento e moderação prévia --}}
                        <div class="alert border-0 rounded-3 mb-4 d-flex gap-3"
                             style="background: #fffdf5; border-left: 4px solid #ffc107 !important;">
                            <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                            <div class="small">
                                <strong class="d-block mb-1">Como funciona o atendimento e a moderação prévia</strong>
                                Ao registrar, você recebe um número de protocolo com opção de comprovante por e-mail e a gestão municipal
                                responde em <strong>até 10 dias úteis</strong>. Para garantir a civilidade durante o piloto de 90 dias, todo relato passa por <strong>revisão da assessoria municipal</strong> antes de ser publicado no feed da cidade, e você acompanha tudo em
                                <a href="/protocolos" class="fw-bold">Meus Protocolos</a>.
                            </div>
                        </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-7">
                                    <label class="form-label fw-bold text-secondary small text-uppercase">Categoria Prioritária (Piloto 90 Dias)</label>
                                    <select name="categoria" class="form-select custom-input" required>
                                        <option value="Iluminação Pública">Iluminação Pública (Postes / Lâmpadas)</option>
                                        <option value="Reparo de Vias e Estradas">Reparo de Vias, Calçamento e Estradas</option>
                                        <option value="Coleta de Lixo e Entulho">Coleta de Lixo e Retirada de Entulho</option>
                                        <option value="Saneamento e Drenagem">Saneamento, Esgoto e Drenagem</option>
                                        <option value="Limpeza e Zeladoria Urbana">Limpeza de Praças e Zeladoria Urbana</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold text-secondary small text-uppercase">Bairro / Localidade</label>
                                    <select name="bairro" class="form-select custom-input">
                                        <option value="">Identificar pelo endereço</option>
                                        <option value="Centro">Centro</option>
                                        <option value="São Vicente">São Vicente</option>
                                        <option value="Nossa Senhora de Fátima">Nossa Senhora de Fátima</option>
                                        <option value="Esplanada">Esplanada</option>
                                        <option value="COHAB">COHAB</option>
                                        <option value="Bela Vista">Bela Vista</option>
                                        <option value="Distrito de Caio Prado">Distrito de Caio Prado</option>
                                        <option value="Distrito de São Sebastião">Distrito de São Sebastião</option>
                                        <option value="Distrito de Angicos">Distrito de Angicos</option>
                                        <option value="Zona Rural / Sítios">Zona Rural / Sítios</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary small text-uppercase">O que precisa de atenção?</label>
                                <input type="text" name="titulo" class="form-control custom-input" placeholder="Ex: Lâmpada queimada ou buraco na via" required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Localização no Mapa (Grátis)</label>
                                
                                <div id="map" class="rounded-4 mb-3 shadow-sm border" style="height: 320px; width: 100%; z-index: 1;"></div>
                                
                                <div class="input-group">
                                    <span class="input-group-text border-0 bg-light text-danger"><i class="bi bi-geo-alt-fill"></i></span>
                                    <input type="text" id="addressInput" name="localizacao" class="form-control custom-input border-start-0" placeholder="Clique no mapa ou digite o endereço e ponto de referência" required>
                                </div>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i> Clique no mapa para posicionar o marcador azul.</small>

                                <input type="hidden" id="latInput" name="latitude">
                                <input type="hidden" id="lngInput" name="longitude">
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Anexar Evidências (Máx. 3)</label>
                                <div class="upload-area rounded-4 p-4 text-center border-dashed position-relative bg-light" id="drop-zone">
                                    <input type="file" id="imgInput" accept="image/*" class="d-none" multiple>
                                    
                                    <div id="placeholder-upload" class="cursor-pointer" onclick="document.getElementById('imgInput').click()">
                                        <i class="bi bi-cloud-arrow-up-fill fs-2 text-primary"></i>
                                        <p class="mb-0 small fw-bold text-muted">Clique para adicionar fotos</p>
                                        <span class="text-black-50" style="font-size: 0.7rem;">Você pode selecionar uma por uma (Limite: 3)</span>
                                    </div>

                                    <div id="preview-grid" class="row g-2 mt-2 d-none"></div>
                                </div>
                                <div id="cloudinaryUrlsContainer"></div> 
                            </div>

                            <div class="mb-5">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Descrição Objetiva da Solicitação</label>
                                <textarea name="descricao" class="form-control custom-input" rows="4" placeholder="Descreva o problema de forma objetiva e respeitosa, sem citar nomes de moradores ou ofensas..." required></textarea>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-shield-check me-1"></i>O sistema possui filtro automático de civilidade e bloqueia termos ofensivos ou ataques pessoais.</small>
                            </div>

                            <div class="d-grid gap-3">
{{> _declaracao}}

                                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3 transition-base">
                                    CONFIRMAR REGISTRO
                                </button>
                                <a href="/categories/gestao_de_melhorias/hub" class="btn btn-link text-decoration-none text-muted fw-bold">
                                    CANCELAR E VOLTAR
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function() {
        let selectedFiles = [];

        const latInicial = -6.5372;
        const lngInicial = -39.4958;

        const map = L.map('map').setView([latInicial, lngInicial], 15);
        const camadaTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap © CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);
        camadaTiles.once('tileerror', () => {
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);
        });

        let marker = L.marker([latInicial, lngInicial], {draggable: true}).addTo(map);

        function updateFields(lat, lng) {
            document.getElementById('latInput').value = lat.toFixed(6);
            document.getElementById('lngInput').value = lng.toFixed(6);
            
            fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                .then(res => res.json())
                .then(data => {
                    if(data.display_name) {
                        document.getElementById('addressInput').value = data.display_name;
                    }
                });
        }

        map.on('click', e => {
            marker.setLatLng(e.latlng);
            updateFields(e.latlng.lat, e.latlng.lng);
        });

        marker.on('dragend', () => {
            const pos = marker.getLatLng();
            updateFields(pos.lat, pos.lng);
        });

        $('#imgInput').on('change', function(e) {
            const files = Array.from(e.target.files);
            files.forEach(file => {
                if (selectedFiles.length < 3) {
                    selectedFiles.push(file);
                }
            });
            renderPreview();
        });

        window.removeFile = function(index) {
            selectedFiles.splice(index, 1);
            renderPreview();
        }

        function renderPreview() {
            const $previewGrid = $('#preview-grid');
            const $placeholder = $('#placeholder-upload');
            $previewGrid.empty();

            if (selectedFiles.length > 0) {
                $previewGrid.removeClass('d-none');
                $placeholder.toggleClass('d-none', selectedFiles.length >= 3);

                selectedFiles.forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const html = `
                            <div class="col-4 position-relative">
                                <div class="ratio ratio-1x1 shadow-sm rounded-3 overflow-hidden border">
                                    <img src="${e.target.result}" class="object-fit-cover w-100 h-100">
                                </div>
                                <button type="button" onclick="removeFile(${index})" 
                                        class="btn btn-danger btn-sm position-absolute top-0 start-100 translate-middle rounded-circle p-0" 
                                        style="width:22px; height:22px; z-index: 10; border: 2px solid white;">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>`;
                        $previewGrid.append(html);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                $previewGrid.addClass('d-none');
                $placeholder.removeClass('d-none');
            }
        }

        $('#mainForm').on('submit', async function(e) {
            e.preventDefault();
            const btn = $('#submitBtn');
            const $urlsContainer = $('#cloudinaryUrlsContainer');
            
            btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Processando...').prop('disabled', true);
            $urlsContainer.empty();

            try {
                if (selectedFiles.length > 0) {
                    for (let file of selectedFiles) {
                        const response = await window.portalEnviarArquivo(file);
                        $urlsContainer.append(`<input type="hidden" name="imagens[]" value="${response.secure_url}">`);
                    }
                }

                this.submit();

            } catch (err) {
                console.error("Erro no Cloudinary:", err);
                window.portalMensagem(err.message || "Não foi possível enviar as imagens.");
                btn.html('CONFIRMAR REGISTRO').prop('disabled', false);
            }
        });
    });
</script>

<style>
    .object-fit-cover { object-fit: cover; }
    .custom-input { background-color: #f8f9fa !important; border: 1px solid #dee2e6 !important; border-radius: 12px !important; padding: 12px 15px; }
    .custom-input:focus { border-color: #13315c !important; box-shadow: none !important; background-color: #fff !important; }
    .border-dashed { border: 2px dashed #cbd5e0; transition: 0.3s; }
    .btn-primary { background-color: #13315c; border: none; }
    .btn-primary:hover { background-color: #0d2342; transform: translateY(-2px); }
    .cursor-pointer { cursor: pointer; }
</style>
