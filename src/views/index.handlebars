{{!-- SEÇÃO 7: MURAL DE DEMANDAS RECENTES E AVISO DE EMERGÊNCIA (190 e 181) --}}
<section class="dsgov-section-pad dsgov-section-gray" id="pedidos-recentes" aria-labelledby="titulo-recentes">
    <div class="container">
        <div class="dsgov-section-header d-flex flex-wrap justify-content-between align-items-end gap-2">
            <div>
                <span class="dsgov-section-kicker">Acompanhamento Comunitário Aberto</span>
                <h2 id="titulo-recentes" class="dsgov-section-title">Últimas Demandas Aprovadas na Cidade</h2>
            </div>
            <a href="/categories/gestao_de_melhorias/hub" class="btn dsgov-btn-outline">
                Ver todos os pedidos
            </a>
        </div>

        <div class="dsgov-table-box mb-5">
            <div class="table-responsive">
                <table class="table table-hover dsgov-table">
                    <thead>
                        <tr>
                            <th scope="col">Protocolo</th>
                            <th scope="col">O que foi solicitado</th>
                            <th scope="col">Bairro / Local</th>
                            <th scope="col">Data</th>
                            <th scope="col">Situação</th>
                            <th scope="col" class="text-end">Detalhes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if demandasRecentes.length}}
                            {{#each demandasRecentes}}
                                <tr>
                                    <td class="font-monospace fw-semibold" style="color: var(--dsgov-blue);">
                                        {{this.numero}}
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">{{recortar this.titulo 65}}</div>
                                        <div class="text-muted" style="font-size: 0.95rem;">{{this.categoria}}</div>
                                    </td>
                                    <td class="fw-medium">
                                        {{this.bairro}}
                                    </td>
                                    <td class="text-muted">
                                        {{formatDay this.dataCriacao}}
                                    </td>
                                    <td>
                                        {{#if (eq this.status 'Resolvido')}}
                                            <span class="dsgov-badge dsgov-badge-green">Resolvido</span>
                                        {{else if (eq this.status 'Em Atendimento')}}
                                            <span class="dsgov-badge dsgov-badge-yellow">Em Atendimento</span>
                                        {{else if (eq this.status 'Improcedente')}}
                                            <span class="dsgov-badge dsgov-badge-neutral">Arquivado</span>
                                        {{else}}
                                            <span class="dsgov-badge dsgov-badge-blue">{{this.status}}</span>
                                        {{/if}}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{this.linkDetalhes}}" class="btn dsgov-btn-outline btn-sm px-3 py-2">
                                            Abrir
                                        </a>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Nenhum pedido público registrado ainda. Use os cartões acima para enviar o primeiro pedido do seu bairro.
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>

        {{!-- Faixa de Emergência Policial (190 e 181 Sem Borda Rígida) --}}
        <div class="dsgov-emergency-bar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-telephone-fill text-danger fs-3" aria-hidden="true"></i>
                <div>
                    <strong class="d-block fs-5 fw-semibold" style="color: var(--dsgov-navy);">Urgência ou crime acontecendo agora?</strong>
                    <span class="text-muted" style="font-size: 1.05rem;">O portal não substitui o acionamento policial imediato. Para emergências em andamento, ligue gratuitamente:</span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <span class="dsgov-badge dsgov-badge-red fs-6 px-3 py-2">
                    <i class="bi bi-telephone-outbound-fill me-1" aria-hidden="true"></i> 190 • Polícia Militar
                </span>
                <span class="dsgov-badge dsgov-badge-neutral fs-6 px-3 py-2">
                    <i class="bi bi-shield-fill-exclamation me-1" aria-hidden="true"></i> 181 • Disque-Denúncia
                </span>
            </div>
        </div>
    </div>
</section>

{{!-- Script de Interatividade Rápida (Abas "Navegue por Categoria" e Carrossel Cívico) --}}
<script>
    function filtrarCategoriaServico(categoria, botaoClicado) {
        var botoes = document.querySelectorAll('.dsgov-cat-btn');
        for (var i = 0; i < botoes.length; i++) {
            botoes[i].classList.remove('ativo');
            botoes[i].setAttribute('aria-selected', 'false');
        }
        if (botaoClicado) {
            botaoClicado.classList.add('ativo');
            botaoClicado.setAttribute('aria-selected', 'true');
        }
        var itens = document.querySelectorAll('.item-categoria-servico');
        for (var j = 0; j < itens.length; j++) {
            var catItem = itens[j].getAttribute('data-cat-item');
            if (categoria === 'todos' || catItem === categoria) {
                itens[j].style.display = '';
            } else {
                itens[j].style.display = 'none';
            }
        }
    }

    function atualizarPillCarrossel(pillClicada) {
        var pills = document.querySelectorAll('.dsgov-carousel-pill');
        for (var i = 0; i < pills.length; i++) {
            pills[i].classList.remove('active');
            pills[i].removeAttribute('aria-current');
        }
        if (pillClicada) {
            pillClicada.classList.add('active');
            pillClicada.setAttribute('aria-current', 'true');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var carrossel = document.getElementById('carrosselDestaquesCivicos');
        if (carrossel) {
            carrossel.addEventListener('slide.bs.carousel', function (evento) {
                var pills = document.querySelectorAll('.dsgov-carousel-pill');
                for (var i = 0; i < pills.length; i++) {
                    if (i === evento.to) {
                        pills[i].classList.add('active');
                        pills[i].setAttribute('aria-current', 'true');
                    } else {
                        pills[i].classList.remove('active');
                        pills[i].removeAttribute('aria-current');
                    }
                }
            });
        }
    });
</script>
