{{!-- ==========================================================================
     PORTAL VOZ ATIVA — LANDING PAGE NO PADRÃO DIGITAL DE GOVERNO (DSGOV)
     Sobriedade institucional, superfície off-white (#F8F9FA), cartões de 1px
     (#DCDCDC), busca direta, Carta de Serviços e Transparência Pública.
     ========================================================================== --}}

{{!-- 1. Barra de Trilha de Navegação (Breadcrumb) e Status Operacional --}}
<div class="dsgov-breadcrumb-bar py-2">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <nav aria-label="Trilha de navegação">
            <ol class="dsgov-breadcrumb">
                <li>
                    <a href="/"><i class="bi bi-house-door-fill me-1" aria-hidden="true"></i>Início</a>
                </li>
                <li aria-hidden="true"><i class="bi bi-chevron-right small"></i></li>
                <li><a href="/categories">Ouvidoria e Serviços</a></li>
                <li aria-hidden="true"><i class="bi bi-chevron-right small"></i></li>
                <li class="fw-semibold text-dark" aria-current="page">Painel de Atendimento ao Cidadão</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 small text-muted">
            <span class="dsgov-badge dsgov-badge-green">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i> Sistema Operacional
            </span>
            <span class="d-none d-md-inline">Cariús/CE • Atendimento Digital e Triagem Moderada</span>
        </div>
    </div>
</div>

{{!-- 2. Faixa Institucional de Comando e Busca Direta (Hero DSGOV) --}}
<header class="dsgov-hero-band" id="busca-portal">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <div class="dsgov-hero-tag">
                    <i class="bi bi-bank2" aria-hidden="true"></i>
                    Plataforma Cívica de Ouvidoria, Zeladoria e Fomento Local
                </div>
                <h1 class="dsgov-hero-title">
                    Ouvidoria Cidadã, Zeladoria Urbana e Vitrine do Trabalhador
                </h1>
                <p class="dsgov-hero-subtitle">
                    Registre solicitações de infraestrutura com geolocalização, envie denúncias com proteção de identidade, acompanhe prazos de resposta por número de protocolo e consulte profissionais autônomos de Cariús.
                </p>

                {{!-- Formulário de Busca Direta nos Hubs Públicos --}}
                <form id="formBuscaPortal" action="/categories/gestao_de_melhorias/hub" method="GET" class="dsgov-search-box" role="search" aria-label="Pesquisar demandas e serviços no portal">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-sm-4 col-md-4">
                            <label for="selectEixoBusca" class="visually-hidden">Módulo de pesquisa</label>
                            <select id="selectEixoBusca" class="form-select dsgov-search-select w-100"
                                    onchange="var f=document.getElementById('formBuscaPortal');if(f)f.action=this.value;">
                                <option value="/categories/gestao_de_melhorias/hub">Gestão de Melhorias</option>
                                <option value="/categories/denuncias_sigilosas/hub">Denúncias Públicas</option>
                                <option value="/categories/vitrine_do_trabalhador/hub">Vitrine do Trabalhador</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-5 col-md-6">
                            <label for="inputTermoBusca" class="visually-hidden">Termo de busca</label>
                            <input type="search" id="inputTermoBusca" name="q" maxlength="100"
                                   class="form-control dsgov-search-input w-100"
                                   placeholder="O que você procura? Ex.: iluminação, asfalto, centro, eletricista...">
                        </div>
                        <div class="col-12 col-sm-3 col-md-2 d-grid">
                            <button type="submit" class="btn dsgov-btn-primary">
                                <i class="bi bi-search me-1" aria-hidden="true"></i>Buscar
                            </button>
                        </div>
                    </div>
                </form>

                {{!-- Atalhos de Assuntos Mais Buscados --}}
                <div class="dsgov-quick-tags" aria-label="Assuntos mais procurados">
                    <span class="text-white-50 fw-semibold me-1">Acesso rápido:</span>
                    <a href="/categories/gestao_de_melhorias/hub?q=Ilumina%C3%A7%C3%A3o" class="dsgov-quick-tag">Iluminação Pública</a>
                    <a href="/categories/gestao_de_melhorias/hub?q=Reparo" class="dsgov-quick-tag">Reparo de Vias</a>
                    <a href="/categories/gestao_de_melhorias/hub?q=Coleta" class="dsgov-quick-tag">Coleta de Lixo e Entulho</a>
                    <a href="/categories/denuncias_sigilosas/hub?q=Queimada" class="dsgov-quick-tag">Foco de Queimada</a>
                    <a href="/categories/vitrine_do_trabalhador/hub" class="dsgov-quick-tag">Serviços Autônomos</a>
                </div>
            </div>

            {{!-- Painel Lateral de Protocolo e Acesso Rápido do Cidadão --}}
            <div class="col-lg-4">
                <div class="dsgov-protocolo-panel">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-uppercase fw-bold small text-muted" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                ATENDIMENTO E PROTOCOLO
                            </span>
                            <h2 class="h5 fw-bold mb-0" style="color: var(--dsgov-navy);">
                                Central do Cidadão
                            </h2>
                        </div>
                        <span class="dsgov-badge dsgov-badge-blue">24h</span>
                    </div>
                    <p class="small text-muted mb-3">
                        Consulte o histórico das suas manifestações, emita comprovantes oficiais em <strong>.TXT / PDF</strong> e acompanhe os prazos regulamentares.
                    </p>

                    <div class="d-grid gap-2">
                        {{#if user}}
                            <a href="/protocolos" class="btn dsgov-btn-primary text-start d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-folder2-open me-2"></i>Consultar Meus Protocolos</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/categories/gestao_de_melhorias/abrir-chamado" class="btn dsgov-btn-outline text-start d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-plus-square me-2"></i>Registrar Nova Solicitação</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            {{#if user.areAdmin}}
                                <a href="/admin/painel" class="btn dsgov-btn-secondary text-start d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-shield-check me-2"></i>Painel de Moderação e Gestão</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            {{/if}}
                        {{else}}
                            <a href="/users/login" class="btn dsgov-btn-primary text-start d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-box-arrow-in-right me-2"></i>Entrar para Acompanhar Protocolos</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/users/register" class="btn dsgov-btn-outline text-start d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person-plus me-2"></i>Criar Conta Cidadã Gratuita</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/categories" class="btn dsgov-btn-secondary text-start d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-grid-3x3-gap me-2"></i>Consultar Mural Público</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        {{/if}}
                    </div>

                    <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                        <span><i class="bi bi-shield-lock-fill text-primary me-1"></i>Opção de relato anônimo</span>
                        <span>SLA: 1 a 10 dias úteis</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

{{!-- 3. Carta de Serviços Públicos e Módulos Operacionais (4 Cards DSGOV) --}}
<section class="py-5" id="servicos-cidadao">
    <div class="container">
        <div class="dsgov-section-header d-flex flex-wrap justify-content-between align-items-end gap-2">
            <div>
                <div class="dsgov-section-kicker">Carta de Serviços Digitais</div>
                <h2 class="dsgov-section-title">Canais de Manifestação, Fiscalização e Trabalho</h2>
            </div>
            <a href="/categories" class="btn dsgov-btn-outline btn-sm">
                Ver todos os módulos <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            {{!-- Card 1: Gestão de Melhorias --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-blue">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="dsgov-service-icon icon-blue">
                                <i class="bi bi-tools" aria-hidden="true"></i>
                            </div>
                            <span class="dsgov-badge dsgov-badge-blue">Zeladoria Urbana</span>
                        </div>
                        <h3 class="h5 fw-bold mb-2" style="color: var(--dsgov-navy);">
                            Gestão de Melhorias
                        </h3>
                        <p class="small text-muted mb-3">
                            Solicitação de reparos em iluminação pública, pavimentação de vias e estradas, coleta de lixo/entulho e manutenção de espaços comunitários.
                        </p>
                        <ul class="list-unstyled small text-secondary mb-3 border-top pt-2">
                            <li class="mb-1"><i class="bi bi-clock me-1 text-primary"></i> <strong>Prazo (SLA):</strong> 3 a 10 dias úteis</li>
                            <li class="mb-1"><i class="bi bi-geo-alt me-1 text-primary"></i> <strong>Recursos:</strong> Mapa GPS + Fotos</li>
                            <li><i class="bi bi-file-earmark-check me-1 text-primary"></i> <strong>Retorno:</strong> Comprovante .TXT/PDF</li>
                        </ul>
                    </div>
                    <div class="d-grid gap-2 pt-2 border-top">
                        <a href="/categories/gestao_de_melhorias/abrir-chamado" class="btn dsgov-btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i>Abrir Solicitação
                        </a>
                        <a href="/categories/gestao_de_melhorias/hub" class="btn dsgov-btn-secondary btn-sm">
                            Consultar Demandas Públicas
                        </a>
                    </div>
                </article>
            </div>

            {{!-- Card 2: Denúncias Sigilosas --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-red">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="dsgov-service-icon icon-red">
                                <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                            </div>
                            <span class="dsgov-badge dsgov-badge-red">Sigilo Protegido</span>
                        </div>
                        <h3 class="h5 fw-bold mb-2" style="color: var(--dsgov-navy);">
                            Denúncias Sigilosas
                        </h3>
                        <p class="small text-muted mb-3">
                            Comunicação de infrações objetivas: focos de queimada, maus-tratos contra animais, descarte irregular de resíduos, poluição sonora e vandalismo.
                        </p>
                        <ul class="list-unstyled small text-secondary mb-3 border-top pt-2">
                            <li class="mb-1"><i class="bi bi-clock me-1 text-danger"></i> <strong>Prazo (SLA):</strong> 1 a 5 dias úteis</li>
                            <li class="mb-1"><i class="bi bi-incognito me-1 text-danger"></i> <strong>Proteção:</strong> Identidade preservada</li>
                            <li><i class="bi bi-camera-video me-1 text-danger"></i> <strong>Anexos:</strong> Fotos e vídeo de evidência</li>
                        </ul>
                    </div>
                    <div class="d-grid gap-2 pt-2 border-top">
                        <a href="/categories/denuncias_sigilosas/abrir-denuncia" class="btn dsgov-btn-primary btn-sm" style="background-color: var(--dsgov-red); border-color: var(--dsgov-red);">
                            <i class="bi bi-shield-exclamation me-1"></i>Registrar Denúncia
                        </a>
                        <a href="/categories/denuncias_sigilosas/hub" class="btn dsgov-btn-secondary btn-sm">
                            Consultar Alertas Públicos
                        </a>
                    </div>
                </article>
            </div>

            {{!-- Card 3: Vitrine do Trabalhador --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-green">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="dsgov-service-icon icon-green">
                                <i class="bi bi-briefcase-fill" aria-hidden="true"></i>
                            </div>
                            <span class="dsgov-badge dsgov-badge-green">Economia Local</span>
                        </div>
                        <h3 class="h5 fw-bold mb-2" style="color: var(--dsgov-navy);">
                            Vitrine do Trabalhador
                        </h3>
                        <p class="small text-muted mb-3">
                            Cadastro público e gratuito de profissionais autônomos, prestadores de serviços, produtores rurais e pequenos comércios de Cariús.
                        </p>
                        <ul class="list-unstyled small text-secondary mb-3 border-top pt-2">
                            <li class="mb-1"><i class="bi bi-check2-circle me-1 text-success"></i> <strong>Custo:</strong> 100% gratuito</li>
                            <li class="mb-1"><i class="bi bi-whatsapp me-1 text-success"></i> <strong>Contato:</strong> Direto e sem intermediários</li>
                            <li><i class="bi bi-shop me-1 text-success"></i> <strong>Catálogo:</strong> Busca por ofício e bairro</li>
                        </ul>
                    </div>
                    <div class="d-grid gap-2 pt-2 border-top">
                        <a href="/categories/vitrine_do_trabalhador/criar-vitrine" class="btn dsgov-btn-primary btn-sm" style="background-color: var(--dsgov-green); border-color: var(--dsgov-green);">
                            <i class="bi bi-person-workspace me-1"></i>Divulgar Meu Serviço
                        </a>
                        <a href="/categories/vitrine_do_trabalhador/hub" class="btn dsgov-btn-secondary btn-sm">
                            Acessar Catálogo de Profissionais
                        </a>
                    </div>
                </article>
            </div>

            {{!-- Card 4: Consulta de Protocolos e Comprovantes --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-navy">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="dsgov-service-icon icon-navy">
                                <i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i>
                            </div>
                            <span class="dsgov-badge dsgov-badge-neutral">Acompanhamento</span>
                        </div>
                        <h3 class="h5 fw-bold mb-2" style="color: var(--dsgov-navy);">
                            Consulta de Protocolo
                        </h3>
                        <p class="small text-muted mb-3">
                            Acompanhamento da linha do tempo de atendimento, respostas da gestão, emissão de 2ª via do comprovante oficial e interposição de recursos.
                        </p>
                        <ul class="list-unstyled small text-secondary mb-3 border-top pt-2">
                            <li class="mb-1"><i class="bi bi-download me-1 text-dark"></i> <strong>Comprovante:</strong> Download .TXT e PDF</li>
                            <li class="mb-1"><i class="bi bi-clock-history me-1 text-dark"></i> <strong>Histórico:</strong> Linha do tempo auditável</li>
                            <li><i class="bi bi-arrow-counterclockwise me-1 text-dark"></i> <strong>Garantia:</strong> Direito a recurso</li>
                        </ul>
                    </div>
                    <div class="d-grid gap-2 pt-2 border-top">
                        <a href="/protocolos" class="btn dsgov-btn-primary btn-sm">
                            <i class="bi bi-folder-check me-1"></i>Acessar Meus Protocolos
                        </a>
                        <a href="#fluxo-atendimento" class="btn dsgov-btn-secondary btn-sm">
                            Como Funciona o Atendimento
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

{{!-- 4. Painel de Transparência Ativa e Demandas Públicas Recentes --}}
<section class="py-4 border-top border-bottom bg-white" id="transparencia-demandas">
    <div class="container py-2">
        <div class="dsgov-section-header d-flex flex-wrap justify-content-between align-items-end gap-2">
            <div>
                <div class="dsgov-section-kicker">Transparência e Dados Abertos</div>
                <h2 class="dsgov-section-title">Resumo Operacional e Últimas Demandas Aprovadas</h2>
            </div>
            <div class="d-flex gap-2">
                {{#if user.areAdmin}}
                    <a href="/admin/metricas" class="btn dsgov-btn-primary btn-sm">
                        <i class="bi bi-bar-chart-line me-1"></i>Indicadores Executivos
                    </a>
                {{/if}}
                <a href="/categories/gestao_de_melhorias/hub" class="btn dsgov-btn-outline btn-sm">
                    Consultar Mural Completo
                </a>
            </div>
        </div>

        {{!-- Indicadores Sólidos --}}
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="dsgov-stat-card">
                    <div class="dsgov-stat-number">{{#if indicadoresResumo}}{{indicadoresResumo.publicadas}}{{else}}0{{/if}}</div>
                    <div class="dsgov-stat-label">Demandas Públicas no Mural</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dsgov-stat-card" style="border-left-color: var(--dsgov-yellow);">
                    <div class="dsgov-stat-number">{{#if indicadoresResumo}}{{indicadoresResumo.emAtendimento}}{{else}}0{{/if}}</div>
                    <div class="dsgov-stat-label">Protocolos em Atendimento</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dsgov-stat-card" style="border-left-color: var(--dsgov-green);">
                    <div class="dsgov-stat-number">{{#if indicadoresResumo}}{{indicadoresResumo.resolvidas}}{{else}}0{{/if}}</div>
                    <div class="dsgov-stat-label">Solicitações Concluídas</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dsgov-stat-card" style="border-left-color: var(--dsgov-navy);">
                    <div class="dsgov-stat-number">{{#if indicadoresResumo}}{{indicadoresResumo.vitrinesAtivas}}{{else}}0{{/if}}</div>
                    <div class="dsgov-stat-label">Trabalhadores Cadastrados</div>
                </div>
            </div>
        </div>

        {{!-- Tabela Institucional de Demandas Recentes --}}
        <div class="dsgov-table-box">
            <div class="px-3 py-2 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-bold small text-uppercase" style="color: var(--dsgov-navy); letter-spacing: 0.04em;">
                    <i class="bi bi-list-Columns-reverse me-1"></i> Registros Públicos Recentes (Aprovados pela Triagem de Ouvidoria)
                </span>
                <span class="small text-muted">Ocorrências sigilosas permanecem restritas ao autor e à moderação</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover dsgov-table">
                    <thead>
                        <tr>
                            <th scope="col">Protocolo</th>
                            <th scope="col">Módulo / Categoria</th>
                            <th scope="col">Assunto da Manifestação</th>
                            <th scope="col">Bairro / Localidade</th>
                            <th scope="col">Data</th>
                            <th scope="col">Situação</th>
                            <th scope="col" class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if demandasRecentes.length}}
                            {{#each demandasRecentes}}
                                <tr>
                                    <td class="font-monospace fw-bold" style="color: var(--dsgov-blue);">
                                        {{this.numero}}
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">{{this.eixoRotulo}}</div>
                                        <div class="small text-muted">{{this.categoria}}</div>
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        {{recortar this.titulo 65}}
                                    </td>
                                    <td>
                                        <i class="bi bi-geo-alt text-muted me-1"></i>{{this.bairro}}
                                    </td>
                                    <td class="text-muted small">
                                        {{formatDay this.dataCriacao}}
                                    </td>
                                    <td>
                                        {{#if (eq this.status 'Resolvido')}}
                                            <span class="dsgov-badge dsgov-badge-green">Resolvido</span>
                                        {{else if (eq this.status 'Em Atendimento')}}
                                            <span class="dsgov-badge dsgov-badge-yellow">Em Atendimento</span>
                                        {{else if (eq this.status 'Improcedente')}}
                                            <span class="dsgov-badge dsgov-badge-neutral">Improcedente</span>
                                        {{else}}
                                            <span class="dsgov-badge dsgov-badge-blue">{{this.status}}</span>
                                        {{/if}}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{this.linkDetalhes}}" class="btn dsgov-btn-outline btn-sm py-1 px-2">
                                            Detalhar
                                        </a>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox me-1"></i> Nenhuma demanda pública listada no momento. Utilize os canais acima para registrar uma nova solicitação ou consulte os murais setoriais.
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

{{!-- 5. Rito de Atendimento e Governança (Passo a Passo Oficial) --}}
<section class="py-5" id="fluxo-atendimento">
    <div class="container">
        <div class="dsgov-section-header">
            <div class="dsgov-section-kicker">Rito Processual de Ouvidoria</div>
            <h2 class="dsgov-section-title">Como Funciona o Tratamento das Manifestações</h2>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">01</div>
                    <h3 class="h6 fw-bold mb-2" style="color: var(--dsgov-navy);">
                        Registro e Comprovante
                    </h3>
                    <p class="small text-muted mb-0">
                        O cidadão preenche o relato com localização e fotos, podendo optar pelo anonimato. O sistema emite na hora o código de protocolo e o comprovante para download (<code>.TXT</code> / PDF) ou e-mail.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">02</div>
                    <h3 class="h6 fw-bold mb-2" style="color: var(--dsgov-navy);">
                        Moderação Prévia e Sigilo
                    </h3>
                    <p class="small text-muted mb-0">
                        Toda nova publicação passa por validação automática de civilidade e revisão prévia da assessoria para proteger dados pessoais e impedir exposições indevidas antes de ir ao mural público.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">03</div>
                    <h3 class="h6 fw-bold mb-2" style="color: var(--dsgov-navy);">
                        Encaminhamento e Prazo (SLA)
                    </h3>
                    <p class="small text-muted mb-0">
                        A demanda é encaminhada ao setor ou autoridade competente com prazo regulamentar (de 1 a 10 dias úteis conforme a urgência). Denúncias graves contam com relatório técnico estruturado.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">04</div>
                    <h3 class="h6 fw-bold mb-2" style="color: var(--dsgov-navy);">
                        Resolução e Direito a Recurso
                    </h3>
                    <p class="small text-muted mb-0">
                        Todas as respostas e mudanças de estágio ficam gravadas na linha do tempo do protocolo. Caso uma solicitação seja arquivada como improcedente, o autor pode interpor recurso fundamentado.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

