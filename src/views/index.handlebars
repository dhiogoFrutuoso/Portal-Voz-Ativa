{{!-- ==========================================================================
     PORTAL VOZ ATIVA — PÁGINA INICIAL SIMPLIFICADA (PADRÃO GOV.BR / DSGOV)
     Linguagem popular e direta, letras grandes e um botão de ação por serviço.
     ========================================================================== --}}

{{!-- 1. Topo Limpo com Pergunta Central e Busca Rápida --}}
<header class="dsgov-hero-band text-center" id="busca-portal">
    <div class="container">
        <h1 class="dsgov-hero-title">
            O que você precisa hoje em Cariús?
        </h1>

        <form id="formBuscaPortal" action="/categories/gestao_de_melhorias/hub" method="GET" class="dsgov-search-box text-start" role="search" aria-label="Pesquisar no portal">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <label for="selectEixoBusca" class="visually-hidden">Onde pesquisar</label>
                    <select id="selectEixoBusca" class="form-select dsgov-search-select w-100"
                            onchange="var f=document.getElementById('formBuscaPortal');if(f)f.action=this.value;">
                        <option value="/categories/gestao_de_melhorias/hub">Conserto de Ruas e Iluminação</option>
                        <option value="/categories/denuncias_sigilosas/hub">Denúncias da Comunidade</option>
                        <option value="/categories/vitrine_do_trabalhador/hub">Profissionais e Serviços</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label for="inputTermoBusca" class="visually-hidden">Digite o que você procura</label>
                    <input type="search" id="inputTermoBusca" name="q" maxlength="100"
                           class="form-control dsgov-search-input w-100"
                           placeholder="Digite uma rua, bairro, problema ou profissão...">
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn dsgov-btn-primary dsgov-search-btn">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Buscar
                    </button>
                </div>
            </div>
        </form>
    </div>
</header>

{{!-- 2. Os 4 Serviços Principais (Fonte Grande, 1 Frase Simples e 1 Botão Largo) --}}
<section class="py-5" id="servicos-cidadao" aria-labelledby="titulo-servicos">
    <div class="container">
        <div class="dsgov-section-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 id="titulo-servicos" class="dsgov-section-title">Serviços para Você</h2>
            <a href="/categories" class="btn dsgov-btn-outline">
                Ver mural da cidade <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            {{!-- Card 1: Conserto de Ruas e Iluminação --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-blue">
                    <div>
                        <div class="dsgov-service-icon icon-blue">
                            <i class="bi bi-lightbulb-fill" aria-hidden="true"></i>
                        </div>
                        <h3 class="dsgov-service-title">
                            Conserto de Ruas e Iluminação
                        </h3>
                        <p class="dsgov-service-desc">
                            Avise sobre poste apagado, buraco na rua ou lixo acumulado no seu bairro.
                        </p>
                    </div>
                    <a href="/categories/gestao_de_melhorias/abrir-chamado" class="dsgov-card-cta cta-blue">
                        <i class="bi bi-plus-circle-fill" aria-hidden="true"></i> Pedir Reparo
                    </a>
                </article>
            </div>

            {{!-- Card 2: Fazer Denúncia com Sigilo --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-red">
                    <div>
                        <div class="dsgov-service-icon icon-red">
                            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                        </div>
                        <h3 class="dsgov-service-title">
                            Fazer Denúncia com Sigilo
                        </h3>
                        <p class="dsgov-service-desc">
                            Denuncie queimadas, maus-tratos a animais ou descarte de lixo sem mostrar seu nome.
                        </p>
                    </div>
                    <a href="/categories/denuncias_sigilosas/abrir-denuncia" class="dsgov-card-cta cta-red">
                        <i class="bi bi-shield-check" aria-hidden="true"></i> Fazer Denúncia Segura
                    </a>
                </article>
            </div>

            {{!-- Card 3: Encontrar Profissionais e Serviços --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-green">
                    <div>
                        <div class="dsgov-service-icon icon-green">
                            <i class="bi bi-briefcase-fill" aria-hidden="true"></i>
                        </div>
                        <h3 class="dsgov-service-title">
                            Encontrar Profissionais e Serviços
                        </h3>
                        <p class="dsgov-service-desc">
                            Encontre trabalhadores e pequenos negócios de Cariús ou divulgue o seu serviço de graça.
                        </p>
                    </div>
                    <a href="/categories/vitrine_do_trabalhador/hub" class="dsgov-card-cta cta-green">
                        <i class="bi bi-people-fill" aria-hidden="true"></i> Ver Trabalhadores
                    </a>
                </article>
            </div>

            {{!-- Card 4: Acompanhar meu Pedido --}}
            <div class="col-12 col-md-6 col-xl-3">
                <article class="dsgov-service-card accent-navy">
                    <div>
                        <div class="dsgov-service-icon icon-navy">
                            <i class="bi bi-folder-check" aria-hidden="true"></i>
                        </div>
                        <h3 class="dsgov-service-title">
                            Acompanhar meu Pedido
                        </h3>
                        <p class="dsgov-service-desc">
                            Veja a resposta da equipe para o seu pedido e baixe o seu comprovante pelo protocolo.
                        </p>
                    </div>
                    <a href="/protocolos" class="dsgov-card-cta cta-navy">
                        <i class="bi bi-search" aria-hidden="true"></i> Acompanhar meu Pedido
                    </a>
                </article>
            </div>
        </div>
    </div>
</section>

{{!-- 3. Como Funciona (3 passos simples) --}}
<section class="py-5 bg-white border-top border-bottom" id="como-funciona" aria-labelledby="titulo-como-funciona">
    <div class="container">
        <div class="dsgov-section-header">
            <h2 id="titulo-como-funciona" class="dsgov-section-title">Como Funciona (3 passos simples)</h2>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">1</div>
                    <h3 class="dsgov-step-title">1. Você relata o problema</h3>
                    <p class="dsgov-step-desc">
                        Tire uma foto, diga a rua e envie sem complicação.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">2</div>
                    <h3 class="dsgov-step-title">2. A equipe recebe e analisa</h3>
                    <p class="dsgov-step-desc">
                        Sua solicitação é verificada com sigilo garantido.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="dsgov-step-card">
                    <div class="dsgov-step-num">3</div>
                    <h3 class="dsgov-step-title">3. O serviço é realizado</h3>
                    <p class="dsgov-step-desc">
                        Acompanhe o andamento pelo seu número de protocolo.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

{{!-- 4. Pedidos Recentes da Comunidade (Tabela Espaçada e de Fácil Leitura) --}}
<section class="py-5" id="pedidos-recentes" aria-labelledby="titulo-recentes">
    <div class="container">
        <div class="dsgov-section-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 id="titulo-recentes" class="dsgov-section-title">Pedidos Recentes na Cidade</h2>
            <a href="/categories/gestao_de_melhorias/hub" class="btn dsgov-btn-outline">
                Ver todos os pedidos
            </a>
        </div>

        <div class="dsgov-table-box mb-4">
            <div class="table-responsive">
                <table class="table table-hover dsgov-table">
                    <thead>
                        <tr>
                            <th scope="col">Protocolo</th>
                            <th scope="col">O que foi pedido</th>
                            <th scope="col">Bairro / Local</th>
                            <th scope="col">Data</th>
                            <th scope="col">Situação</th>
                            <th scope="col" class="text-end">Ver</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if demandasRecentes.length}}
                            {{#each demandasRecentes}}
                                <tr>
                                    <td class="font-monospace fw-bold" style="color: var(--dsgov-blue);">
                                        {{this.numero}}
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">{{recortar this.titulo 65}}</div>
                                        <div class="text-muted" style="font-size: 0.92rem;">{{this.categoria}}</div>
                                    </td>
                                    <td class="fw-semibold">
                                        {{this.bairro}}
                                    </td>
                                    <td class="text-muted">
                                        {{formatDay this.dataCriacao}}
                                    </td>
                                    <td>
                                        {{#if (eq this.status 'Resolvido')}}
                                            <span class="dsgov-badge dsgov-badge-green">Resolvido</span>
                                        {{else if (eq this.status 'Em Atendimento')}}
                                            <span class="dsgov-badge dsgov-badge-yellow">Em Atendimento</span>
                                        {{else if (eq this.status 'Improcedente')}}
                                            <span class="dsgov-badge dsgov-badge-neutral">Arquivado</span>
                                        {{else}}
                                            <span class="dsgov-badge dsgov-badge-blue">{{this.status}}</span>
                                        {{/if}}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{this.linkDetalhes}}" class="btn dsgov-btn-outline btn-sm px-3 py-2">
                                            Abrir
                                        </a>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Nenhum pedido público registrado ainda. Use os botões acima para enviar o primeiro pedido do seu bairro.
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>

        {{!-- 5. Telefones de Emergência Visíveis e Limpos (190 e 181) --}}
        <div class="dsgov-emergency-bar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-telephone-fill text-danger fs-3" aria-hidden="true"></i>
                <div>
                    <strong class="d-block fs-5" style="color: var(--dsgov-navy);">Urgência ou crime acontecendo agora?</strong>
                    <span class="text-muted" style="font-size: 1rem;">Para casos graves e imediatos, ligue gratuitamente:</span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <span class="dsgov-badge dsgov-badge-red fs-6 px-3 py-2">
                    190 • Polícia Militar
                </span>
                <span class="dsgov-badge dsgov-badge-neutral fs-6 px-3 py-2">
                    181 • Disque-Denúncia
                </span>
            </div>
        </div>
    </div>
</section>
