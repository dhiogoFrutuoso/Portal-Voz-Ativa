<style>
    .card-estagio {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .card-estagio:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
        color: inherit;
    }

    .card-estagio.ativo {
        border-width: 2px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
    }

    .linha-protocolo {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
    }

    .faixa-status {
        width: 6px;
        border-radius: 0.9rem 0 0 0.9rem;
    }

    .miniatura {
        width: 84px;
        height: 84px;
        object-fit: cover;
        border-radius: 0.6rem;
    }

    .avatar-mini {
        width: 26px;
        height: 26px;
        object-fit: cover;
        border-radius: 50%;
    }

    /* Chama atenção para a novidade sem virar distração */
    .novidade-pulsa {
        animation: novidade-pulso 2s ease-in-out infinite;
    }

    @keyframes novidade-pulso {
        0%, 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.45); }
        50% { box-shadow: 0 0 0 6px rgba(220, 53, 69, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .novidade-pulsa { animation: none; }
    }

    .linha-com-novidade {
        border-color: #f5c2c7 !important;
        background: #fffafa;
    }
</style>

<header class="py-5 text-white shadow-lg" style="background: linear-gradient(145deg, #1d3557 0%, #e63946 100%); border-bottom: 5px solid #ffc107;">
    <div class="container px-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="bi bi-shield-lock-fill me-1"></i> ÁREA RESTRITA
                </span>
                <h1 class="display-5 fw-bolder mb-2">Painel de Protocolos</h1>
                <p class="lead mb-0 opacity-75 fw-light">
                    Gestão de melhorias e denúncias sigilosas de Cariús.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-block bg-white bg-opacity-10 border border-light border-opacity-25 rounded-4 px-4 py-3">
                    <div class="small text-uppercase text-white-50 fw-bold">Protocolos listados</div>
                    <div class="display-6 fw-bold">{{totalGeral}}</div>
                </div>
            </div>
        </div>
    </div>
</header>

<section class="py-5 bg-light">
    <div class="container px-4">

        {{!-- Visão geral por estágio: cada card filtra a lista na hora, sem recarregar --}}
        <div data-busca-painel data-busca-rota="/admin/painel/buscar" data-busca-alvo="#resultados">
        <div class="row g-3 mb-4">
            {{#each resumo}}
                <div class="col-6 col-lg">
                    <button type="button"
                            class="card-estagio p-3 h-100 shadow-sm border-{{this.cor}} w-100 text-start"
                            data-filtro="status" data-valor="{{this.chave}}">
                        <div class="text-{{this.cor}} fs-4 mb-1"><i class="bi {{this.icone}}"></i></div>
                        <div class="h3 fw-bold mb-0">{{this.total}}</div>
                        <div class="small fw-bold">{{this.rotulo}}</div>
                        <div class="small text-muted lh-sm mt-1" style="font-size: 0.75rem;">{{this.descricao}}</div>
                    </button>
                </div>
            {{/each}}
        </div>

        {{!-- Busca em tempo real --}}
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <form action="/admin/painel" method="GET" class="row g-2 align-items-center">
                    <div class="col-md">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="q" value="{{termo}}" maxlength="100" autocomplete="off"
                                   class="form-control border-start-0 rounded-end-3" data-busca-campo
                                   placeholder="Título, descrição, local ou tipo de ocorrência...">
                        </div>
                    </div>
                    <div class="col-md-auto d-grid">
                        <button type="submit" class="btn btn-dark rounded-3 px-4 fw-bold">Buscar</button>
                    </div>
                </form>

                <div class="d-flex align-items-center flex-wrap gap-2 mt-3">
                    <span class="small text-muted text-uppercase fw-bold me-1">Categoria</span>
                    <button type="button" class="btn btn-sm btn-filtro ativo" data-filtro="tipo" data-valor="">Todas</button>
                    {{#each eixos}}
                        <button type="button" class="btn btn-sm btn-filtro" data-filtro="tipo" data-valor="{{this.chave}}">
                            <i class="bi {{this.icone}} me-1"></i>{{this.rotuloCurto}}
                        </button>
                    {{/each}}
                    <button type="button" class="btn btn-sm btn-filtro ms-lg-3" data-filtro="novidade" data-valor="sim">
                        <i class="bi bi-bell-fill me-1"></i>Só com resposta nova
                    </button>
                </div>

                <div class="small text-muted mt-3 mb-0">
                    <span data-busca-contador>{{totalGeral}}</span> protocolo(s) em exibição.
                    <span class="ms-2 fst-italic" data-busca-status></span>
                </div>
            </div>
        </div>

        {{!-- Lista --}}
        {{#if protocolos.length}}
            <div class="d-flex flex-column gap-3" id="resultados">
                {{> _linhas_painel protocolos=protocolos}}
            </div>
        {{else}}
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-inbox"></i></div>
                <h5 class="fw-bold">Nenhum protocolo encontrado</h5>
                <p class="text-muted mb-0">Ajuste os filtros ou limpe a busca para ver todos os registros.</p>
            </div>
        {{/if}}
        </div>
    </div>
</section>
