<style>
    .card-estagio {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .card-estagio:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
        color: inherit;
    }

    .card-estagio.ativo {
        border-width: 2px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
    }

    .linha-protocolo {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
    }

    .faixa-status {
        width: 6px;
        border-radius: 0.9rem 0 0 0.9rem;
    }

    .miniatura {
        width: 84px;
        height: 84px;
        object-fit: cover;
        border-radius: 0.6rem;
    }

    .avatar-mini {
        width: 26px;
        height: 26px;
        object-fit: cover;
        border-radius: 50%;
    }
</style>

<header class="py-5 text-white shadow-lg" style="background: linear-gradient(145deg, #1d3557 0%, #e63946 100%); border-bottom: 5px solid #ffc107;">
    <div class="container px-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="bi bi-shield-lock-fill me-1"></i> ÁREA RESTRITA
                </span>
                <h1 class="display-5 fw-bolder mb-2">Painel de Protocolos</h1>
                <p class="lead mb-0 opacity-75 fw-light">
                    Gestão de melhorias e denúncias sigilosas de Cariús.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-block bg-white bg-opacity-10 border border-light border-opacity-25 rounded-4 px-4 py-3">
                    <div class="small text-uppercase text-white-50 fw-bold">Protocolos listados</div>
                    <div class="display-6 fw-bold">{{totalGeral}}</div>
                </div>
            </div>
        </div>
    </div>
</header>

<section class="py-5 bg-light">
    <div class="container px-4">

        {{!-- Visão geral por estágio: cada card filtra a lista abaixo --}}
        <div class="row g-3 mb-4">
            {{#each resumo}}
                <div class="col-6 col-lg">
                    <a href="{{this.link}}" class="card-estagio p-3 h-100 shadow-sm border-{{this.cor}} {{#if this.ativo}}ativo{{/if}}">
                        <div class="text-{{this.cor}} fs-4 mb-1"><i class="bi {{this.icone}}"></i></div>
                        <div class="h3 fw-bold mb-0">{{this.total}}</div>
                        <div class="small fw-bold">{{this.rotulo}}</div>
                        <div class="small text-muted lh-sm mt-1" style="font-size: 0.75rem;">{{this.descricao}}</div>
                    </a>
                </div>
            {{/each}}
        </div>

        {{!-- Filtros e busca --}}
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form action="/admin/painel" method="GET" class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label small fw-bold text-uppercase text-muted">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" value="{{termo}}" maxlength="100"
                                   class="form-control border-start-0 rounded-end-3"
                                   placeholder="Título, descrição, local ou tipo de ocorrência...">
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Categoria</label>
                        <select name="tipo" class="form-select rounded-3">
                            <option value="todos" {{#if (eq tipoFiltro 'todos')}}selected{{/if}}>Todas as categorias</option>
                            {{#each eixos}}
                                <option value="{{this.chave}}" {{#if (eq this.chave ../tipoFiltro)}}selected{{/if}}>
                                    {{this.rotulo}}
                                </option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Estágio</label>
                        <select name="status" class="form-select rounded-3">
                            <option value="todos" {{#if (eq statusFiltro 'todos')}}selected{{/if}}>Todos os estágios</option>
                            {{#each estagios}}
                                <option value="{{this.chave}}" {{#if (eq this.chave ../statusFiltro)}}selected{{/if}}>
                                    {{this.rotulo}}
                                </option>
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-lg-1 d-grid">
                        <button type="submit" class="btn btn-dark rounded-3 fw-bold">Ir</button>
                    </div>
                </form>

                {{#if termo}}
                    <div class="mt-3 small text-muted">
                        Resultados para <strong>“{{termo}}”</strong>.
                        <a href="/admin/painel" class="ms-2">limpar busca</a>
                    </div>
                {{/if}}
            </div>
        </div>

        {{!-- Lista --}}
        {{#if protocolos.length}}
            <div class="d-flex flex-column gap-3">
                {{#each protocolos}}
                    <div class="linha-protocolo shadow-sm overflow-hidden">
                        <div class="d-flex">
                            <div class="faixa-status bg-{{this.estagio.cor}}"></div>

                            <div class="flex-grow-1 p-4">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                            <span class="badge bg-{{this.eixo.cor}} rounded-pill px-3">
                                                <i class="bi {{this.eixo.icone}} me-1"></i>{{this.eixo.rotuloCurto}}
                                            </span>
                                            <span class="badge bg-{{this.estagio.cor}} rounded-pill px-3">{{this.estagio.rotulo}}</span>
                                            {{#if this.tipoOcorrencia}}
                                                <span class="badge bg-light text-dark border rounded-pill px-3">{{this.tipoOcorrencia}}</span>
                                            {{/if}}
                                            <span class="small text-muted font-monospace">{{this.numero}}</span>
                                        </div>

                                        <div class="d-flex gap-3">
                                            {{#if this.imagemPrincipal}}
                                                <img src="{{this.imagemPrincipal}}" alt="" class="miniatura flex-shrink-0">
                                            {{/if}}

                                            <div>
                                                <h5 class="fw-bold mb-1">{{this.titulo}}</h5>
                                                <p class="text-muted small mb-2">{{recortar this.descricao 180}}</p>

                                                <div class="d-flex align-items-center flex-wrap gap-3 small text-muted">
                                                    {{#if this.autor}}
                                                        <span class="d-flex align-items-center">
                                                            <img src="{{this.autor.profileImage}}" alt="" class="avatar-mini me-1">
                                                            {{this.autor.name}}
                                                        </span>
                                                    {{else}}
                                                        <span><i class="bi bi-person-x me-1"></i>Autor indisponível</span>
                                                    {{/if}}
                                                    <span><i class="bi bi-geo-alt me-1"></i>{{recortar this.localizacao 40}}</span>
                                                    <span><i class="bi bi-calendar3 me-1"></i>{{formatDay this.dataCriacao}}</span>
                                                    <span><i class="bi bi-chat-left-text me-1"></i>{{this.respostas}}</span>
                                                    <span><i class="bi bi-hourglass-split me-1"></i>até {{formatDay this.limite}}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    {{!-- Alteração rápida de estágio --}}
                                    <div class="col-md-4">
                                        <form action="/admin/protocolo/{{this.tipo}}/{{this._id}}/status" method="POST" class="bg-light rounded-3 p-3">
                                            <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">

                                            <label class="form-label small fw-bold text-uppercase text-muted mb-1">Alterar estágio</label>
                                            <select name="status" class="form-select form-select-sm rounded-3 mb-2">
                                                {{#each @root.estagios}}
                                                    <option value="{{this.chave}}" {{#if (eq this.chave ../status)}}selected{{/if}}>
                                                        {{this.rotulo}}
                                                    </option>
                                                {{/each}}
                                            </select>

                                            <button type="submit" class="btn btn-dark btn-sm w-100 rounded-3 fw-bold mb-2">
                                                Salvar estágio
                                            </button>

                                            <div class="d-grid gap-1">
                                                <a href="{{this.linkProtocolo}}" class="btn btn-outline-dark btn-sm rounded-3">
                                                    <i class="bi bi-chat-square-text me-1"></i> Abrir atendimento
                                                </a>
                                                <a href="{{this.linkPost}}" class="btn btn-link btn-sm text-decoration-none">
                                                    ver publicação
                                                </a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-inbox"></i></div>
                <h5 class="fw-bold">Nenhum protocolo encontrado</h5>
                <p class="text-muted mb-0">Ajuste os filtros ou limpe a busca para ver todos os registros.</p>
            </div>
        {{/if}}
    </div>
</section>
