{{!-- Busca em tempo real + botões de filtro.

     Recebe: acao (rota da página), rota (endpoint que devolve os cards),
     termo, total, placeholder, alvo (seletor da lista) e as listas de filtros
     (filtrosEstagio, filtrosOcorrencia, filtrosCategoria, filtrosTipo).

     O formulário continua funcionando sem JavaScript: o submit vai para `acao`
     e o servidor devolve a página filtrada como sempre. --}}
<div class="card border-0 shadow-sm rounded-4 mb-4"
     data-busca-painel
     data-busca-rota="{{rota}}"
     data-busca-alvo="{{#if alvo}}{{alvo}}{{else}}#resultados{{/if}}">
    <div class="card-body p-3 p-md-4">
        <form action="{{acao}}" method="GET" class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="q" value="{{termo}}" maxlength="100"
                           class="form-control border-start-0 rounded-end-3"
                           autocomplete="off"
                           data-busca-campo
                           placeholder="{{placeholder}}">
                </div>
            </div>

            <div class="col-md-auto d-grid">
                <button type="submit" class="btn btn-dark rounded-3 px-4 fw-bold">Buscar</button>
            </div>

            {{#if termo}}
                <div class="col-md-auto d-grid">
                    <a href="{{acao}}" class="btn btn-outline-secondary rounded-3 px-4">Limpar</a>
                </div>
            {{/if}}
        </form>

        {{!-- Botões de filtro: alternam a visibilidade na hora, sem recarregar --}}
        {{#if filtrosEstagio}}
            <div class="filtros-grupo mt-3">
                <span class="filtros-rotulo">Estágio</span>
                <button type="button" class="btn-filtro ativo" data-filtro="status" data-valor="">Todos</button>
                {{#each filtrosEstagio}}
                    <button type="button" class="btn-filtro" data-filtro="status" data-valor="{{this.chave}}">
                        <i class="bi {{this.icone}} me-1"></i>{{this.rotulo}}
                    </button>
                {{/each}}
            </div>
        {{/if}}

        {{#if filtrosTipo}}
            <div class="filtros-grupo mt-2">
                <span class="filtros-rotulo">Categoria</span>
                <button type="button" class="btn-filtro ativo" data-filtro="tipo" data-valor="">Todas</button>
                {{#each filtrosTipo}}
                    <button type="button" class="btn-filtro" data-filtro="tipo" data-valor="{{this.chave}}">
                        <i class="bi {{this.icone}} me-1"></i>{{this.rotuloCurto}}
                    </button>
                {{/each}}
            </div>
        {{/if}}

        {{#if filtrosOcorrencia}}
            <div class="filtros-grupo mt-2">
                <span class="filtros-rotulo">Ocorrência</span>
                <button type="button" class="btn-filtro ativo" data-filtro="ocorrencia" data-valor="">Todas</button>
                {{#each filtrosOcorrencia}}
                    <button type="button" class="btn-filtro" data-filtro="ocorrencia" data-valor="{{this}}">{{this}}</button>
                {{/each}}
            </div>
        {{/if}}

        {{#if filtrosCategoria}}
            <div class="filtros-grupo mt-2">
                <span class="filtros-rotulo">Categoria</span>
                <button type="button" class="btn-filtro ativo" data-filtro="categoria" data-valor="">Todas</button>
                {{#each filtrosCategoria}}
                    <button type="button" class="btn-filtro" data-filtro="categoria" data-valor="{{this}}">{{this}}</button>
                {{/each}}
            </div>
        {{/if}}

        <div class="small text-muted mt-3 mb-0">
            <span data-busca-contador>{{total}}</span> item(ns) em exibição.
            <span class="ms-2 fst-italic" data-busca-status>
                {{#if termo}}resultado(s) para “{{termo}}”{{/if}}
            </span>
        </div>
    </div>
</div>
