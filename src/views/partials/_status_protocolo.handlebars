{{!-- Cartão de status do protocolo na página de detalhes.

     Antes cada tópico trazia um texto fixo ("Em Análise Técnica", "Urgente"),
     que nunca mudava quando a gestão alterava o estágio. Agora reflete o
     estágio real, com a mesma cor e ícone usados no hub e no painel.

     Recebe: estagio, prazo, limite, linkProtocolo, podeAcompanhar e rotulo. --}}
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <h6 class="text-uppercase fw-bold text-muted small mb-3">{{#if rotulo}}{{rotulo}}{{else}}Protocolo Cariús{{/if}}</h6>

    <div class="mb-3">
        <label class="d-block small text-muted">Situação atual:</label>
        <span class="badge bg-{{estagio.cor}} rounded-pill fw-bold px-3 py-2">
            <i class="bi {{estagio.icone}} me-1"></i>{{estagio.rotulo}}
        </span>
        <div class="small text-muted mt-2">{{estagio.descricao}}</div>
    </div>

    {{#if prazo}}
        <div class="pt-3 border-top">
            {{#if prazo.encerrado}}
                {{!-- Resolvido ou improcedente: não há prazo em aberto. --}}
                <label class="d-block small text-muted">Prazo de resposta:</label>
                <span class="small text-muted fst-italic">Atendimento encerrado — sem prazo em aberto.</span>
            {{else}}
                <label class="d-block small text-muted">Prazo de resposta:</label>
                <span class="fw-bold">{{prazo.dias}} dias úteis</span>
                {{#if limite}}
                    <div class="small text-muted">Previsão até {{formatDay limite}}.</div>
                {{/if}}
            {{/if}}
        </div>
    {{/if}}

    {{#if podeAcompanhar}}
        <a href="{{linkProtocolo}}" class="btn btn-outline-primary btn-sm rounded-3 w-100 mt-3">
            <i class="bi bi-clock-history me-1"></i> Ver histórico do atendimento
        </a>
    {{/if}}
</div>
