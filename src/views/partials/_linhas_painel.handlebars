{{!-- Linhas da lista de protocolos.

     Fica em partial porque serve tanto à página completa quanto ao trecho que a
     busca em tempo real devolve. --}}
{{#each protocolos}}
                    <div class="linha-protocolo shadow-sm overflow-hidden item-filtravel {{#if this.novidades.paraAGestao}}linha-com-novidade{{/if}}"
                         data-status="{{this.status}}" data-tipo="{{this.tipo}}"
                         data-moderacao="{{this.moderacao.chave}}"
                         data-sigilo="{{#if this.privada}}sigilosa{{else}}publica{{/if}}"
                         data-novidade="{{#if this.novidades.paraAGestao}}sim{{else}}nao{{/if}}"
                         data-recurso="{{#if this.recurso.pendente}}pendente{{else}}nao{{/if}}">
                        <div class="d-flex">
                            <div class="faixa-status bg-{{this.estagio.cor}}"></div>

                            <div class="flex-grow-1 p-4">
                                <div class="row g-3">
                                    <div class="col-12 col-md-8">
                                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                            <span class="badge bg-{{this.eixo.cor}} rounded-pill px-3">
                                                <i class="bi {{this.eixo.icone}} me-1"></i>{{this.eixo.rotuloCurto}}
                                            </span>
                                            <span class="badge bg-{{this.estagio.cor}} rounded-pill px-3">{{this.estagio.rotulo}}</span>
                                            <span class="badge bg-{{this.moderacao.cor}} {{#if (eq this.moderacao.cor 'warning')}}text-dark{{/if}} rounded-pill px-3">
                                                <i class="bi {{this.moderacao.icone}} me-1"></i>{{this.moderacao.rotulo}}
                                            </span>
                                            {{#if this.tipoOcorrencia}}
                                                <span class="badge bg-light text-dark border rounded-pill px-3">{{this.tipoOcorrencia}}</span>
                                            {{/if}}
                                            {{#if this.categoria}}
                                                <span class="badge bg-light text-primary border rounded-pill px-3">{{this.categoria}}</span>
                                            {{/if}}
                                            {{#if this.bairro}}
                                                <span class="badge bg-light text-secondary border rounded-pill px-3"><i class="bi bi-pin-map me-1"></i>{{this.bairro}}</span>
                                            {{/if}}
                                            {{#if this.isConfidential}}
                                                <span class="badge bg-dark text-white rounded-pill px-3" title="Postagem anônima no feed público; autoria preservada internamente para fins judiciais">
                                                    <i class="bi bi-incognito me-1"></i>Anônimo no Feed
                                                </span>
                                            {{/if}}
                                            <span class="small text-muted font-monospace">{{this.numero}}</span>
                                            {{> _novidade mostrar=this.novidades.paraAGestao texto="o cidadão respondeu"}}
                                            {{#if this.recurso.pendente}}
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 novidade-pulsa">
                                                    <i class="bi bi-megaphone-fill me-1"></i>recurso a analisar
                                                </span>
                                            {{/if}}
                                        </div>

                                        <div class="d-flex gap-3">
                                            {{#if this.imagemPrincipal}}
                                                <img src="{{this.imagemPrincipal}}" alt="" class="miniatura flex-shrink-0">
                                            {{/if}}

                                            <div class="w-100">
                                                <h5 class="fw-bold mb-1">{{this.titulo}}</h5>
                                                <p class="text-muted small mb-2">{{recortar this.descricao 180}}</p>

                                                <div class="d-flex align-items-center flex-wrap gap-3 small text-muted">
                                                    {{#if this.autor}}
                                                        <span class="d-flex align-items-center" title="Registro interno de autoria">
                                                            <img src="{{this.autor.profileImage}}" alt="" class="avatar-mini me-1">
                                                            {{this.autor.name}}
                                                        </span>
                                                    {{else}}
                                                        <span><i class="bi bi-person-x me-1"></i>Autor indisponível</span>
                                                    {{/if}}
                                                    <span><i class="bi bi-geo-alt me-1"></i>{{recortar this.localizacao 40}}</span>
                                                    <span><i class="bi bi-calendar3 me-1"></i>{{formatDay this.dataCriacao}}</span>
                                                    <span><i class="bi bi-chat-left-text me-1"></i>{{this.respostas}}</span>
                                                    {{#if this.prazo.encerrado}}
                                                        <span><i class="bi bi-check2-all me-1"></i>encerrado</span>
                                                    {{else}}
                                                        <span><i class="bi bi-hourglass-split me-1"></i>até {{formatDay this.limite}}</span>
                                                    {{/if}}
                                                </div>

                                                {{#if this.moderacao.moderadoEm}}
                                                    <div class="small text-muted mt-2 pt-2 border-top">
                                                        <i class="bi bi-person-check-fill text-success me-1"></i>
                                                        Moderado por <strong>{{this.moderacao.moderadoPorNome}}</strong> em {{formatDate this.moderacao.moderadoEm}}
                                                        {{#if this.moderacao.orgaoEncaminhado}}
                                                            • Encaminhado: <strong>{{this.moderacao.orgaoEncaminhado}}</strong>
                                                        {{/if}}
                                                        {{#if this.moderacao.textoEditadoPelaModeracao}}
                                                            <span class="badge bg-info bg-opacity-10 text-dark border ms-1">Texto revisado</span>
                                                        {{/if}}
                                                    </div>
                                                {{/if}}

                                                {{!-- Painel rápido de Moderação Prévia (Assessor Governamental) --}}
                                                <div class="mt-3">
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" type="button"
                                                            data-bs-toggle="collapse" data-bs-target="#moderar-{{this._id}}">
                                                        <i class="bi bi-sliders me-1"></i> Triagem / Moderar / Editar Texto / Encaminhar
                                                    </button>
                                                    {{#if (eq this.tipo 'denuncia')}}
                                                        <a href="/admin/protocolo/denuncia/{{this._id}}/exportar-delegacia"
                                                           class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold ms-1">
                                                            <i class="bi bi-shield-shaded me-1"></i> Exportar p/ Delegacia
                                                        </a>
                                                    {{/if}}

                                                    <div class="collapse mt-3" id="moderar-{{this._id}}">
                                                        <div class="card card-body bg-light border-0 rounded-4 p-3">
                                                            <h6 class="fw-bold small text-uppercase text-dark mb-2">
                                                                <i class="bi bi-shield-check text-primary me-1"></i> Moderação Prévia do Assessor
                                                            </h6>
                                                            <form action="/admin/protocolo/{{this.tipo}}/{{this._id}}/moderar" method="POST">
                                                                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">

                                                                <div class="mb-2">
                                                                    <label class="form-label small fw-bold mb-1">Ação de Moderação</label>
                                                                    <select name="acao" class="form-select form-select-sm rounded-3" required>
                                                                        <option value="aprovar" {{#if (eq this.moderacao.chave 'aprovado')}}selected{{/if}}>Aprovar para o Feed Público</option>
                                                                        <option value="editar_aprovar">Editar Texto (Sanitizar) e Aprovar para o Feed</option>
                                                                        <option value="editar_texto">Apenas Editar/Sanitizar Texto (Manter Status)</option>
                                                                        <option value="encaminhar" {{#if (eq this.moderacao.chave 'encaminhado')}}selected{{/if}}>Encaminhar Internamente a Órgão Competente</option>
                                                                        <option value="sigilar">Tornar Sigiloso (Retirar do Feed Público)</option>
                                                                        <option value="bloquear" {{#if (eq this.moderacao.chave 'bloqueado')}}selected{{/if}}>Bloquear por Violação das Diretrizes</option>
                                                                    </select>
                                                                </div>

                                                                <div class="row g-2 mb-2">
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-bold mb-1">Título (remova nomes próprios ou ofensas antes de aprovar)</label>
                                                                        <input type="text" name="titulo" value="{{this.titulo}}" maxlength="120" class="form-control form-control-sm rounded-3">
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-bold mb-1">Descrição revisada</label>
                                                                        <textarea name="descricao" rows="3" maxlength="5000" class="form-control form-control-sm rounded-3">{{this.descricao}}</textarea>
                                                                    </div>
                                                                </div>

                                                                <div class="row g-2 mb-2">
                                                                    <div class="col-12 col-md-6">
                                                                        <label class="form-label small fw-bold mb-1">Órgão Municipal / Autoridade (se aplicável)</label>
                                                                        <select name="orgaoEncaminhado" class="form-select form-select-sm rounded-3"
                                                                                onchange="var c=this.parentElement.querySelector('.campo-outro-orgao');if(c){c.classList.toggle('d-none',this.value!=='Outros');if(this.value==='Outros')c.focus();}">
                                                                            <option value="">— Selecionar órgão —</option>
                                                                            {{#each @root.orgaosEncaminhamento}}
                                                                                <option value="{{this}}" {{#if (eq this ../moderacao.orgaoEncaminhado)}}selected{{/if}}>{{this}}</option>
                                                                            {{/each}}
                                                                            <option value="Outros">Outros (especificar)</option>
                                                                        </select>
                                                                        <input type="text" name="orgaoEncaminhadoOutro" maxlength="120"
                                                                               value="{{this.moderacao.orgaoEncaminhado}}"
                                                                               placeholder="Especifique o órgão ou autoridade..."
                                                                               class="form-control form-control-sm rounded-3 mt-1 campo-outro-orgao d-none">
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <label class="form-label small fw-bold mb-1">Motivo de bloqueio / Nota de auditoria</label>
                                                                        <input type="text" name="notaModeracao" value="{{this.moderacao.notaModeracao}}" maxlength="500"
                                                                               placeholder="Justificativa ou despacho interno..." class="form-control form-control-sm rounded-3">
                                                                    </div>
                                                                </div>

                                                                <div class="d-flex justify-content-end gap-2 mt-2">
                                                                    <button type="submit" class="btn btn-primary btn-sm rounded-3 px-3 fw-bold">
                                                                        <i class="bi bi-check2-circle me-1"></i> Registrar Decisão de Moderação
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    {{!-- Ações da gestão.

                                         O bloco de sigilo tem formulário próprio, então precisa
                                         ficar FORA do formulário de estágio: <form> dentro de
                                         <form> é inválido em HTML, o navegador descarta o de
                                         dentro e os dois campos _csrf acabam no mesmo envio. --}}
                                    <div class="col-12 col-md-4">
                                        <div class="bg-light rounded-3 p-3">
                                            <form action="/admin/protocolo/{{this.tipo}}/{{this._id}}/status" method="POST">
                                                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">

                                                <label class="form-label small fw-bold text-uppercase text-muted mb-1">Alterar estágio</label>
                                                <select name="status" class="form-select form-select-sm rounded-3 mb-2">
                                                    {{#each @root.estagios}}
                                                        <option value="{{this.chave}}" {{#if (eq this.chave ../status)}}selected{{/if}}>
                                                            {{this.rotulo}}
                                                        </option>
                                                    {{/each}}
                                                </select>

                                                <button type="submit" class="btn btn-dark btn-sm w-100 rounded-3 fw-bold">
                                                    Salvar estágio
                                                </button>
                                            </form>

                                            {{#if this.podeMudarSigilo}}
                                                <div class="d-flex align-items-center gap-2 flex-wrap mt-2 pt-2 border-top">
                                                    {{> _sigilo privada=this.privada id=this._id tipo=this.tipo csrfToken=@root.csrfToken ehAdmin=true}}
                                                </div>
                                            {{/if}}

                                            <div class="d-grid gap-1 mt-2">
                                                <a href="{{this.linkProtocolo}}" class="btn btn-outline-dark btn-sm rounded-3">
                                                    <i class="bi bi-chat-square-text me-1"></i> Abrir atendimento completo
                                                </a>
                                                <a href="{{this.linkPost}}" class="btn btn-link btn-sm text-decoration-none">
                                                    ver publicação
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
