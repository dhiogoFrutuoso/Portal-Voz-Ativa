{{!-- Barra Institucional de Utilidades e Acessibilidade (Padrão DSGOV) --}}
<div class="dsgov-topbar" role="region" aria-label="Barra de utilidades e acessibilidade">
  <div class="container d-flex flex-wrap justify-content-between align-items-center py-1 gap-2">
    <div class="d-flex align-items-center gap-2">
      <span class="dsgov-topbar-sigla">PORTAL VOZ ATIVA</span>
      <span class="dsgov-topbar-sep d-none d-sm-inline" aria-hidden="true">|</span>
      <span class="dsgov-topbar-sub d-none d-sm-inline">SERVIÇOS E ATENDIMENTO AO CIDADÃO DE CARIÚS</span>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-3">
      <div class="d-none d-lg-flex align-items-center gap-3 dsgov-atalhos" aria-label="Atalhos de navegação">
        <a href="#conteudo-principal" accesskey="1" class="dsgov-topbar-link">Conteúdo [1]</a>
        <a href="#servicos-cidadao" accesskey="2" class="dsgov-topbar-link">Serviços [2]</a>
        <a href="#busca-portal" accesskey="3" class="dsgov-topbar-link">Busca [3]</a>
      </div>
      <div class="d-flex align-items-center gap-3">
        <button type="button" id="btnAltoContraste" class="dsgov-topbar-btn" aria-pressed="false" title="Alternar modo de alto contraste">
          <i class="bi bi-circle-half me-1" aria-hidden="true"></i>Alto Contraste
        </button>
        <a href="https://cearadevalores.com.br/" target="_blank" rel="noopener noreferrer" class="dsgov-topbar-link fw-bold">CEARÁ DE VALORES</a>
      </div>
    </div>
  </div>
</div>

{{!-- Cabeçalho Institucional Principal (Padrão DSGOV) --}}
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top dsgov-navbar" aria-label="Navegação principal do portal">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center py-1" href="/">
      <div class="dsgov-brand-mark">
        <span class="dsgov-brand-kicker">CARIÚS • CEARÁ</span>
        <span class="dsgov-brand-title">Portal Voz Ativa</span>
      </div>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navGov" aria-controls="navGov" aria-expanded="false" aria-label="Abrir menu de navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navGov">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center dsgov-nav-list">
        <li class="nav-item">
          <a class="nav-link dsgov-nav-link{{#if paginaInicial}} active{{/if}}" href="/"{{#if paginaInicial}} aria-current="page"{{/if}}>Início</a>
        </li>
        <li class="nav-item">
          <a class="nav-link dsgov-nav-link" href="/categories">Serviços</a>
        </li>
        {{#if this.user.areAdmin}}
          <li class="nav-item">
            <a class="nav-link dsgov-nav-link" href="/admin/">
               <i class="bi bi-shield-lock me-1"></i>Painel Admin
            </a>
          </li>
        {{/if}}

        {{#if user}}
          <li class="nav-item">
            <a class="nav-link dsgov-nav-link" href="/protocolos">
               <i class="bi bi-folder-check me-1"></i>Meus Pedidos
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link dsgov-nav-link" href="/users/perfil/{{this.user._id}}">
               <i class="bi bi-person-badge me-1"></i>Perfil
            </a>
          </li>
          <li class="nav-item ms-lg-2">
            <a class="btn dsgov-btn-secondary btn-sm px-3" href="/users/logout">
              <i class="bi bi-box-arrow-right me-1"></i>Sair
            </a>
          </li>
        {{else}}
          <li class="nav-item ms-lg-2 register">
            <a class="btn dsgov-btn-primary btn-sm px-3 py-2" href="/users/login">
              <i class="bi bi-person-fill me-1" aria-hidden="true"></i>Entrar com sua conta
            </a>
          </li>
        {{/if}}
      </ul>
    </div>
  </div>
</nav>

<script>
  (function () {
    try {
      var chave = 'voz_ativa_alto_contraste';
      var btn = document.getElementById('btnAltoContraste');
      if (localStorage.getItem(chave) === '1') {
        document.body.classList.add('dsgov-alto-contraste');
        if (btn) btn.setAttribute('aria-pressed', 'true');
      }
      if (btn) {
        btn.addEventListener('click', function () {
          var ativo = document.body.classList.toggle('dsgov-alto-contraste');
          btn.setAttribute('aria-pressed', ativo ? 'true' : 'false');
          try { localStorage.setItem(chave, ativo ? '1' : '0'); } catch (e) {}
        });
      }
    } catch (e) {}
  })();
</script>
